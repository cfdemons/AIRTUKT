surfaces
{
    type            surfaces;
    libs            (sampling);
    writeControl    writeTime;

    surfaceFormat   foam;
    fields          (U omega k nut);

    interpolationScheme cellPointFace;  //<- default

    surfaces
    {
        xNormal
        {
            type        cuttingPlane;
            point       (-0.28 0 0);
            normal      (0 1 0);
            //interpolate true;
        }
    }
}


