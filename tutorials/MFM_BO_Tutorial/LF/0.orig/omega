FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 5.263878619;

boundaryField
{
    inlet
    {
        type            timeVaryingMappedFixedValue;
        setAverage      0;
        offset          0;
    }

    outlet
    {
        type            zeroGradient;
    }

    "(plate|hemisphere)"
    {
        type            fixedValue;
        value           uniform 1489.800599;
    }

    tunnel
    {
        type  		slip;
    }

    symmetry
    {
        type 		symmetryPlane;
    }
}


